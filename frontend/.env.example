# Frontend Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_URL_PROD=https://api.sadaaalkuwait.com/api

# Payment Gateway (KNET)
NEXT_PUBLIC_KNET_MERCHANT_ID=your_knet_merchant_id
NEXT_PUBLIC_KNET_GATEWAY_URL=https://checkout.knet.com.kw

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key

# WhatsApp Business
NEXT_PUBLIC_WHATSAPP_NUMBER=+965XXXXXXXX
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello%20Sadaat%20Al%20Kuwait,%20I%20need%20help%20with

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA_XXXXXXXXX

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_key_here
NEXTAUTH_URL_INTERNAL=http://localhost:3000
